# Application Environment (production or development)
APP_ENV=production

# Application Base URL
APP_URL=https://autoclear.infinityfreeapp.com/

# Database Configuration
DB_HOST=sqlXXX.infinityfree.com
DB_USER=your_db_user_here
DB_PASS=your_db_password_here
DB_NAME=your_db_name_here

# Session Name
SESSION_NAME=clearance_sess

# Mail Configuration (Brevo REST API)
MAIL_FROM=your_email@domain.com
BREVO_API_KEY=your_brevo_api_key_here

# Clearance Form Token Secret (HMAC-SHA256 signing key)
APP_SECRET=your_random_app_secret_here
